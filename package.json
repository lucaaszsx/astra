{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "astra",
  "description": "Astra is a streaming service for films and series, designed to help you discover and watch content easily in one place.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "movies",
    "series",
    "streaming",
    "subscriptions",
    "cinema",
    "action",
    "science",
    "romance",
    "horror",
    "tv"
  ],
  "contributors": [
    {
      "email": "jlucasmelob558@gmail.com",
      "name": "Lucas Melo",
      "url": "https://github.com/lucaaszsx"
    },
    {
      "email": "ngeff@outlook.com.br",
      "name": "Geferson Amaro",
      "url": "https://github.com/NGeff"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucaaszsx/astra.git"
  },
  "bugs": {
    "url": "https://github.com/lucaaszsx/astra/issues"
  },
  "homepage": "https://github.com/lucaaszsx/astra#README",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@release-it/conventional-changelog": "^11.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "release-it": "^20.0.1",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}",
      "tagAnnotation": "Release v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "refactor",
              "section": "Refactoring"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "chore",
              "section": "Chores",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "test",
              "hidden": true
            },
            {
              "type": "ci",
              "hidden": true
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  }
}
